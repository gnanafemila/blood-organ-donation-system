                    String dOrgan = sc.nextLine();
                    If (dOrgan.isBlank()) dOrgan = null;

                    Donor donor = new Donor(dName, dAge, dBlood, dOrgan);
                    Hospital.registerDonor(donor);
                    Break;

                Case 2:
                    System.out.print(“Enter Recipient Name: “);
                    String rName = sc.nextLine();
                    System.out.print(“Enter Required Blood Group: “);
                    String rBlood = sc.nextLine();
                    System.out.print(“Enter Required Organ (leave blank if needs blood): “);
                    String rOrgan = sc.nextLine();
                    If (rOrgan.isBlank()) rOrgan = null;

                    Recipient recipient = new Recipient(rName, rBlood, rOrgan);
                    Hospital.registerRecipient(recipient);

                    Try {
                        Hospital.matchRecipient(recipient);
                    } catch (InvalidDonationException e) {
                        System.out.println(e.getMessage());
                    }
                    Break;

                Case 3:
                    Hospital.displayDonors();
                    Break;

                Case 4:
                    Hospital.displayRecipients();
