Package donation;

Import java.util.*;

// ================== INTERFACE ==================
Interface Donation {
    Void donate();
}

// ================== CUSTOM EXCEPTION ==================
Class InvalidDonationException extends Exception {
    Public InvalidDonationException(String message) {
        Super(message);
    }
}

// ================== DONOR CLASS ==================
Class Donor implements Donation {
    Private String name;
    Private int age;
    Private String bloodGroup;
    Private String organ; // null if only blood donor

    Public Donor(String name, int age, String bloodGroup, String organ) {
        This.name = name;
        This.age = age;
        This.bloodGroup = bloodGroup;
        This.organ = organ;
    }

    Public String getBloodGroup() {
        Return bloodGroup;
    }

    Public String getOrgan() {
        Return organ;
    }

    @Override
    Public void donate() {
        System.out.println(name + “ registered as a donor of “ +
                (organ != null ? organ : “Blood”) +
                “ [Blood Group: “ + bloodGroup + “]”);
    }

    @Override
    Public String toString() {
        Return “Donor: “ + name + “, Age: “ + age + “, BloodGroup: “ + bloodGroup +
                (organ != null ? “, Organ: “ + organ : “, Blood donor”);
    }
}

// ================== RECIPIENT CLASS ==================
Class Recipient {
    Private String name;
    Private String requiredBloodGroup;
    Private String requiredOrgan;

    Public Recipient(String name, String requiredBloodGroup, String requiredOrgan) {
        This.name = name;
        This.requiredBloodGroup = requiredBloodGroup;
        This.requiredOrgan = requiredOrgan;
    }

    Public String getRequiredBloodGroup() {
        Return requiredBloodGroup;
    }

    Public String getRequiredOrgan() {
        Return requiredOrgan;
    }

    @Override
    Public String toString() {
        Return “Recipient: “ + name + “, Needs “ +
                (requiredOrgan != null ? requiredOrgan : “Blood”) +
                “ [Blood Group: “ + requiredBloodGroup + “]”;
    }
}

// ================== HOSPITAL CLASS ==================
Class Hospital {
    Private List<Donor> donorList = new ArrayList<>();
    Private List<Recipient> recipientList = new ArrayList<>();

    // Register donor
    Public void registerDonor(Donor donor) {
        donorList.add(donor);
        donor.donate();
    }

    // Register recipient
    Public void registerRecipient(Recipient recipient) {
        recipientList.add(recipient);
        System.out.println(“Recipient registered: “ + recipient);
    }

    // Match recipient with donor
    Public void matchRecipient(Recipient recipient) throws InvalidDonationException {
        Boolean found = false;
        For (Donor donor : donorList) {
            // Organ donation
            If (recipient.getRequiredOrgan() != null && donor.getOrgan() != null &&
                    Recipient.getRequiredOrgan().equalsIgnoreCase(donor.getOrgan()) &&
                    Recipient.getRequiredBloodGroup().equalsIgnoreCase(donor.getBloodGroup())) {
                System.out.println(“Match found!\n” + donor + “\n” + recipient);
                Found = true;
                Break;
            }
            // Blood donation
            Else if (recipient.getRequiredOrgan() == null && donor.getOrgan() == null &&
                    Recipient.getRequiredBloodGroup().equalsIgnoreCase(donor.getBloodGroup())) {
                System.out.println(“ Blood donation match found!\n” + donor + “\n” + recipient);
                Found = true;
                Break;
            }
        }
        If (!found) {
            Throw new InvalidDonationException(“ No matching donor found for “ + recipient);
        }
    }

    // Display donors
    Public void displayDonors() {
        If (donorList.isEmpty()) {
            System.out.println(“No donors registered yet.”);
        } else {
            System.out.println(“=== List of Donors ===”);
            For (Donor d : donorList) {
                System.out.println(d);
            }
        }
    }

    // Display recipients
    Public void displayRecipients() {
        If (recipientList.isEmpty()) {
            System.out.println(“ No recipients registered yet.”);
        } else {
            System.out.println(“=== List of Recipients ===”);
            For (Recipient r : recipientList) {
                System.out.println(r);
            }
        }
    }
}

